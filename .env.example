# Gmail credentials & IMAP configuration
GMAIL_EMAIL=your-email@gmail.com
GMAIL_APP_PASSWORD=your-app-password
GMAIL_LABEL=Privat/Obsidian
IMAP_SERVER=imap.gmail.com
OUTPUT_DIR=./inbox

# Polling interval in seconds (default: 600 = 10 minutes)
CHECK_INTERVAL=600

# Set to true to run once and exit (default: false)
RUN_ONCE=false

# Timezone (e.g., Europe/Berlin, UTC)
TZ=Europe/Berlin

# Optional: Rclone remote path (e.g., gdrive:Obsidian/Inbox)
# If set, script will 'rclone move' files from OUTPUT_DIR to this path
RCLONE_REMOTE_PATH=gdrive:Dokumente/Obsidian/daviddiener/00_Inbox

# Path to your host's rclone configuration directory (contains rclone.conf)
RCLONE_CONFIG_DIR=~/.config/rclone
[Unit]
Description=Mail to Obsidian Parser
After=network.target

[Service]
Type=oneshot
WorkingDirectory=/home/%u/Workspace/mail2obsidian
ExecStart=/home/%u/miniconda3/bin/python3 /home/%u/Workspace/mail2obsidian/src/main.py
EnvironmentFile=/home/%u/Workspace/mail2obsidian/.env

[Install]
WantedBy=multi-user.target
